{
    "compilerOptions": {
        "allowJs": true,
        "noEmit": false,
        "strict": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "declaration": true,
        "outDir": "./dist/",
        "rewriteRelativeImportExtensions": true,
        "allowImportingTsExtensions": true
    },
    "extends": "@tsconfig/node18/tsconfig.json",
    "include": ["node_modules/bc-stubs/bc/**/*.d.ts", "**/*"],
    "ts-node": {
        "files": true
    }
}
