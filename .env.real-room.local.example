# Copy this file to .env.real-room.local and fill in the local test-room values.
BC_REAL_ROOM_TEST_ENABLED=false
BC_TEST_DRY_RUN=true
BC_TEST_SERVER_URL=https://replace-with-approved-server.example/socket
BC_TEST_ENV=live
BC_TEST_USERNAME=TestVeraTown
BC_TEST_PASSWORD=replace-locally
BC_TEST_ROOM=replace-with-existing-room
BC_TEST_TARGET_MEMBER_NUMBER=replace-with-bot-member-number
BC_TEST_TIMEOUT_MS=10000
# Use help for the non-destructive protocol smoke test, or release-observe
# for a production-room appearance invariance check. Neither mutates an avatar.
BC_TEST_SCENARIO=help
# Required only for BC_TEST_SCENARIO=bunny-step in a dedicated test room.
BC_TEST_ALLOW_BUNNY_PUNISHMENT=false
BC_TEST_BUNNY_STAGING_POSITION=1,1
BC_TEST_BUNNY_POSITION=29,6
BC_TEST_EXPECTED_RELEASE_MS=10000
# Evidence is written locally with credentials and configured secret values redacted.
QUALIFICATION_EVIDENCE_DIR=out/qualification-evidence
