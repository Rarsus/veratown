# Copy this file to .env.real-room.local and fill in the local test-room values.
BC_REAL_ROOM_TEST_ENABLED=false
BC_TEST_DRY_RUN=true
BC_TEST_SERVER_URL=https://replace-with-approved-server.example/socket
BC_TEST_ENV=test
BC_TEST_USERNAME=TestVeraTown
BC_TEST_PASSWORD=replace-locally
BC_TEST_ROOM=replace-with-existing-room
BC_TEST_TARGET_MEMBER_NUMBER=replace-with-bot-member-number
BC_TEST_TIMEOUT_MS=10000
# Use help for the non-destructive protocol smoke test, release-observe for a
# production-room appearance invariance check, or movement-path for an explicit
# test-room movement qualification derived from the joined room map.
BC_TEST_SCENARIO=help
# Required only for BC_TEST_SCENARIO=movement-path. This scenario is test-only,
# changes the test account's position, and refuses to run without all guards.
BC_TEST_ALLOW_MOVEMENT=false
BC_TEST_MOVEMENT_CONFIRM_ROOM=replace-with-existing-room
BC_TEST_MOVEMENT_START_POSITION=19,17
BC_TEST_MOVEMENT_MIN_STEPS=2
BC_TEST_MOVEMENT_MAX_STEPS=12
# Optional; omit to select a reachable target from the live room map.
# BC_TEST_MOVEMENT_TARGET_POSITION=replace-with-map-coordinate
# release-test is destructive and requires all three guards below. Use only
# with an explicitly approved dedicated test account and room.
BC_TEST_ALLOW_RELEASE_MUTATION=false
BC_TEST_RELEASE_CONFIRM_ROOM=replace-with-existing-room
BC_TEST_RELEASE_FIXTURE=ItemArms/HeavyYoke
# Required only for BC_TEST_SCENARIO=bunny-step in a dedicated test room.
BC_TEST_ALLOW_BUNNY_PUNISHMENT=false
BC_TEST_BUNNY_STAGING_POSITION=1,1
BC_TEST_BUNNY_POSITION=29,6
BC_TEST_EXPECTED_RELEASE_MS=10000
# Evidence is written locally with credentials and configured secret values redacted.
QUALIFICATION_EVIDENCE_DIR=out/qualification-evidence
