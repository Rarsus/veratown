# pnpm configuration
# Package verification and hoisting settings

# Enable pre/post scripts for proper build preparation
enable-pre-post-scripts=true

# Public hoisting for dependencies to reduce duplication
public-hoist-pattern[]=*
public-hoist-pattern[]=@types/*

# Approve builds for packages that need them in CI
# pnpm v11 requires explicit approval; these are safe and necessary
auto-install-peers=true

# Docker build settings
# For CI environments, use a more lenient policy
# This allows packages to build when needed
# (set via PNPM_SCRIPT_ALLOW_SCRIPTS env var if needed)
public-hoist-pattern[]=esbuild
public-hoist-pattern[]=mongodb-memory-server
