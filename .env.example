# Discord Bot Environment Configuration Example
# Copy this file to .env and fill in your Discord bot credentials
# IMPORTANT: Never commit .env to git - add to .gitignore

# Discord Bot Configuration
DISCORD_ENABLED=true

# Get these from Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here_replace_with_actual_token

# Your Discord server ID (right-click server > Copy Server ID)
DISCORD_GUILD_ID=your_server_id_here_replace_with_actual_id

# Admin role IDs (JSON array, copy role IDs from server settings)
# Get by: right-click role > Copy Role ID
DISCORD_ADMIN_ROLES='["YOUR_ROLE_ID_1", "YOUR_ROLE_ID_2"]'

# Optional: Channel ID for audit logs (copy channel ID)
DISCORD_AUDIT_CHANNEL_ID=optional_audit_channel_id

# MongoDB Configuration (if using environment variables)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
# MONGODB_DB=ropeybot

# Optional: Override BC bot settings
# BOT_USER=your_bot_username
# BOT_PASSWORD=your_bot_password
# BOT_ENV=production
# BC_SERVER_URL=https://bondage-club-server.herokuapp.com/

# Optional: Logging
# LOG_LEVEL=info
# LOG_FILE=/bot/logs/ropeybot.log
