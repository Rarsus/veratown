{
    "name": "ropeybot",
    "license": "Apache-2.0",
    "private": "true",
    "scripts": {
        "preinstall": "cd src && pnpm install",
        "types": "tsc",
        "test:unit": "node --import tsx --test bin/botConnections.test.ts bin/games/__tests__/dare.test.ts bin/games/__tests__/effectSystems.test.ts bin/games/veratown/shared/__tests__/helpers.test.ts bin/games/veratown/shared/__tests__/sprint1-systems.test.ts bin/games/veratown/shared/__tests__/sprint2-refactoring.test.ts bin/games/casino/__tests__/forfeitService.test.ts bin/games/casino/__tests__/bioManager.test.ts bin/games/casino/__tests__/betValidator.test.ts bin/games/casino/__tests__/gameTimer.test.ts bin/games/casino/__tests__/roulette.test.ts bin/games/casino/__tests__/blackjack.test.ts bin/games/dare/__tests__/turnOrderManager.test.ts bin/games/dare/__tests__/turnTimerManager.test.ts bin/games/dare/__tests__/disconnectTracker.test.ts bin/games/dare/__tests__/dareEffectApplier.test.ts bin/games/dare/__tests__/commandHandlers.test.ts bin/games/dare/__tests__/gameParticipant.test.ts bin/games/shared/__tests__/commandValidator.test.ts bin/games/veratown/__tests__/tileTriggerSystem.test.ts",
        "prettier": "prettier -c .",
        "compile:bc-bot": "cd src && npm run compile",
        "bundle": "npm run compile:bc-bot && esbuild bin/main.ts --bundle --platform=node --outfile=dist/bundle.js --sourcemap",
        "start": "npm run compile:bc-bot && tsx bin/main.ts",
        "docker": "pnpm run bundle && docker build -t ropeybot --no-cache ."
    },
    "dependencies": {
        "bc-bot": "link:src",
        "bc-stubs": "131.0.0",
        "lodash": "^4.17.21",
        "lz-string": "^1.5.0",
        "mongodb": "^6.21.0",
        "prettier": "^3.7.4",
        "prom-client": "^14.2.0"
    },
    "devDependencies": {
        "@tsconfig/node18": "^18.2.6",
        "@types/lodash": "^4.17.21",
        "@types/node": "^20.19.27",
        "esbuild": "^0.27.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}
